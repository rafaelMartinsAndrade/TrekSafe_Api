{
  "name": "treksafe-api",
  "version": "1.0.0",
  "description": "API para autenticação de usuários do TrekSafe",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prisma": "node serverPrisma.js",
    "dev": "nodemon server.js",
